# --- Equity Research Desk ---------------------------------------------------
# Copy to .env in the repo root OR backend/.env
# Never commit real keys.

# Runtime
SMP_ENVIRONMENT=development            # development | staging | production
SMP_DATABASE_URL=sqlite:///./data/desk.db
SMP_CORS_ORIGINS=http://localhost:3810,http://127.0.0.1:3810,http://localhost:3811,http://127.0.0.1:3811
SMP_LOG_LEVEL=INFO
SMP_LOG_JSON=false                     # true => one JSON object per line (for log shippers)

# --- Access control -----------------------------------------------------------------------
# Anyone can read. Admin actions (run desk, edit universe, desk defaults) need either:
#   - a signed-in admin (Auth.js in the web app mints a bearer token; the API verifies it
#     with SMP_AUTH_JWT_SECRET and checks the email against SMP_ADMIN_EMAILS), or
#   - the machine credential SMP_API_KEY sent as `X-API-Key` (cron, scripts).
# With both empty (local dev) admin endpoints are open and the API warns at startup.
# Production refuses to start unless one of them is set. Generate: openssl rand -base64 48
SMP_AUTH_JWT_SECRET=
SMP_ADMIN_EMAILS=
SMP_API_KEY=

# Rate limits: anonymous per IP, signed-in per user. Health and SSE are exempt.
SMP_RATE_LIMIT_DEFAULT=120/minute
SMP_RATE_LIMIT_RUNS=5/minute
SMP_RATE_LIMIT_WRITES=60/minute

# Research universe (comma-separated US tickers)
SMP_DEFAULT_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,AVGO,LLY,JPM,V,UNH,XOM,CAT,HD,COST,WMT,PG,JNJ,GE,GS
SMP_RISK_APPETITE=balanced             # conservative | balanced | aggressive
SMP_NEWS_LOOKBACK_DAYS=5
SMP_MAX_NEWS_PER_TICKER=8
SMP_MAX_UNIVERSE_SIZE=60               # hard cap on tickers per run / universe
SMP_INGEST_CONCURRENCY=4               # parallel tickers during ingest (mind vendor rate limits)
SMP_HTTP_TIMEOUT=12                    # seconds per upstream market/news request
SMP_LLM_TIMEOUT=60                     # seconds per LLM call
SMP_RUN_HISTORY_LIMIT=200              # oldest runs beyond this are pruned

# Force bundled research fixtures (useful for demos / CI)
SMP_FORCE_DEMO_DATA=false

# SEC EDGAR requires a descriptive User-Agent with a contact address
SMP_SEC_USER_AGENT=Equity Research Desk local-dev contact@example.com

# Optional auto desk refresh (hours). 0 disables.
SMP_SCHEDULER_HOURS=0

# --- LLM (at least one). Without a key, agents fall back to transparent heuristics. ---
# Provider order when several are set: SMP_LLM_BASE_URL, OpenAI, Anthropic, Cursor.
OPENAI_API_KEY=
SMP_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
SMP_ANTHROPIC_MODEL=claude-sonnet-4-5
# Cursor: https://cursor.com/dashboard → API Keys / Integrations
# Cursor has no public chat-completions URL. With only CURSOR_API_KEY set, synthesis
# uses a no-repo Cloud Agent (slower; raise SMP_LLM_TIMEOUT, e.g. 180). For a local
# OpenAI-compatible proxy, set SMP_CURSOR_BASE_URL (e.g. http://127.0.0.1:8765/v1).
CURSOR_API_KEY=
SMP_CURSOR_MODEL=composer-2.5
SMP_CURSOR_BASE_URL=
# Optional OpenAI-compatible gateway (Groq, OpenRouter, Ollama, Azure AI)
SMP_LLM_BASE_URL=
SMP_LLM_API_KEY=
SMP_LLM_MODEL=

# --- Market / news (licensed APIs — do not scrape publisher sites) ---
FINNHUB_API_KEY=
NEWSAPI_KEY=
ALPHAVANTAGE_API_KEY=

# Desk venue: us, in-nse, in-bse, uk-lse, jp-tse, hk-hkex, de-xetr, ca-tsx,
# au-asx, fr-epa, nl-ams, kr-krx, br-b3, sg-sgx, tw-twse, cn-sse, ch-six
SMP_DEFAULT_MARKET=us

# --- Web app ---------------------------------------------------------------------------------
# Build-time; anything NEXT_PUBLIC_ is visible in the browser. Empty = same origin (production
# behind Caddy). Local dev talks to uvicorn directly.
NEXT_PUBLIC_API_URL=http://localhost:8810

# Optional sign-in (Auth.js). Put these in frontend/.env.local for `npm run dev`.
# AUTH_SECRET=                      # openssl rand -base64 48
# AUTH_URL=http://localhost:3810
# SMP_AUTH_JWT_SECRET=              # same value as the API's
# SMP_ADMIN_EMAILS=you@example.com  # same list as the API's (display only; the API decides)
# AUTH_GITHUB_ID= / AUTH_GITHUB_SECRET=   callback http://localhost:3810/api/auth/callback/github
# AUTH_GOOGLE_ID= / AUTH_GOOGLE_SECRET=   redirect http://localhost:3810/api/auth/callback/google
# AUTH_RESEND_KEY= / AUTH_RESEND_FROM=    email links; needs DATABASE_URL (Postgres)
# DATABASE_URL=postgresql://desk:desk@localhost:5432/desk
