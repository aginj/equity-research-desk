# --- Equity Research Desk production environment ------------------------------------------
# Copy to deploy/.env.production and fill in. Never commit the real file.
#
#   openssl rand -base64 48      # generate secrets
#
# Compose reads this file (via --env-file) for interpolation AND passes it to the api/web
# containers (via env_file), so one file configures everything.

# Domain + Let's Encrypt contact
SMP_DOMAIN=desk.example.com
SMP_ACME_EMAIL=you@example.com

# Postgres (internal only; never published)
POSTGRES_DB=desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=change-me
BACKUP_KEEP_DAYS=14

# Auth.js session encryption (web) — openssl rand -base64 48
AUTH_SECRET=change-me

# Shared secret used by the web app to mint API tokens and by the API to verify them.
SMP_AUTH_JWT_SECRET=change-me

# Comma-separated emails that get the admin role (run desk, edit universe, defaults).
SMP_ADMIN_EMAILS=you@example.com

# Optional machine credential for scripts / cron hitting the API directly.
SMP_API_KEY=

# --- Sign-in providers (configure at least one) -----------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers
#   Callback URL: https://DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Email magic links via Resend (https://resend.com). Requires Postgres (verification tokens).
AUTH_RESEND_KEY=
AUTH_RESEND_FROM=Equity Research Desk <login@example.com>

# --- Desk configuration (see .env.example for the full list) ----------------------------
SMP_DEFAULT_MARKET=us
SMP_RISK_APPETITE=balanced
SMP_SCHEDULER_HOURS=6
SMP_FORCE_DEMO_DATA=false
SMP_SEC_USER_AGENT=Equity Research Desk production you@example.com

# Anonymous rate limits (per IP) and admin run trigger limit
SMP_RATE_LIMIT_DEFAULT=120/minute
SMP_RATE_LIMIT_RUNS=5/minute

# --- LLM / data vendors ------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
SMP_CURSOR_MODEL=composer-2.5
SMP_CURSOR_BASE_URL=
SMP_LLM_BASE_URL=
SMP_LLM_API_KEY=
SMP_LLM_MODEL=
FINNHUB_API_KEY=
NEWSAPI_KEY=
ALPHAVANTAGE_API_KEY=
